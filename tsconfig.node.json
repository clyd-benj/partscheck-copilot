{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["vite.config.ts", "manifest.config.ts", "vitest.config.ts"]
}
